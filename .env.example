# Bayesian ML Platform — environment overrides (copy to .env to use).
# All settings have production defaults; only override what you need.

# Data / reproducibility
BMP_SEED=42
BMP_N_SAMPLES=1200
BMP_N_FEATURES=6
BMP_TEST_FRACTION=0.25

# Laplace logistic regression
BMP_PRIOR_VAR=4.0
BMP_MAX_NEWTON_ITERS=50
BMP_NEWTON_TOL=0.000001
BMP_N_POSTERIOR_SAMPLES=400

# MCMC
BMP_MCMC_SAMPLES=2000
BMP_MCMC_BURN_IN=500
BMP_MCMC_PROPOSAL_STD=0.08

# Serving / decisioning
BMP_ABSTAIN_STD=0.18
BMP_COST_FP=1.0
BMP_COST_FN=5.0
BMP_SERVE_BUDGET_MS=100

# Promotion gates
BMP_ACCURACY_FLOOR=0.75
BMP_AUC_FLOOR=0.80
BMP_ECE_CEILING=0.08
BMP_COVERAGE_FLOOR=0.80
BMP_MIN_EVAL_CASES=100

# Drift
BMP_KL_WARN=0.5
BMP_KL_CRITICAL=2.0
BMP_PSI_WARN=0.10
BMP_PSI_CRITICAL=0.25
